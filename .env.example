# Copy to .env.local and fill in. Never commit .env.local.

# Signs session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- AWS / DynamoDB ---
# ca-central-1 keeps patient data in Canada, which matters under PHIPA.
AWS_REGION=ca-central-1
# Omit these in production if the host provides an IAM role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Point at DynamoDB Local instead of real AWS during development.
# Leave blank to use the real thing.
# DYNAMODB_ENDPOINT=http://localhost:8000

# Table names (defaults shown; only set these to override)
# USERS_TABLE=remedy-users
# SESSIONS_TABLE=remedy-sessions
# INVITES_TABLE=remedy-invites

# --- Cookies ---
# Leave BLANK in local dev so the cookie works on localhost.
# In production set to .myremedy.app so the session is shared with
# dash.myremedy.app (leading dot matters).
COOKIE_DOMAIN=

# --- Dashboard ---
# Where a successful login sends the user.
DASHBOARD_URL=https://dash.myremedy.app

# Where to send someone whose session expired. Leave blank on the main site so
# it uses its own /login. On the dashboard deployment set this to
# https://myremedy.app/login so expired sessions land where the form lives.
LOGIN_URL=
# Same value, exposed to the client for the navbar's Dashboard button.
NEXT_PUBLIC_DASHBOARD_URL=https://dash.myremedy.app

# --- Admin ---
# Comma-separated emails allowed to manage invites at /admin/invites
ADMIN_EMAILS=xsmu0922@gmail.com
